package entities;



import java.text.SimpleDateFormat;
import java.util.Date;

public class UsedProduct extends Product{
	
	private Date manuefactureDate;

	public UsedProduct(String name, Double price, Date manuefactureDate) {
		super(name, price);
		this.manuefactureDate = manuefactureDate;
	}

	public Date getManuefactureDate() {
		return manuefactureDate;
	}

	public void setManuefactureDate(Date manuefactureDate) {
		this.manuefactureDate = manuefactureDate;
	}
	
	 
	  
	@Override
	public String priceTag() {
		SimpleDateFormat sdf = new SimpleDateFormat("dd/MM/yyyy");
		return "(Usado) $"+getPrice()+"Data de Fabrição:"+ sdf.format(manuefactureDate);
	}
	
	
	
	
}
